# Copy to .env in the repo root and fill in. NEVER commit .env.
# frontend/web reads NEXT_PUBLIC_* from frontend/web/.env.local, so copy those lines there too.

# --- Supabase (Project Settings > API) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=          # server only, never expose to the browser
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Gemini (https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# --- Resend (https://resend.com/api-keys) ---
RESEND_API_KEY=

# --- Google Maps (Cloud Console > APIs & Services > Credentials) ---
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- App ---
PORT=4000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_USE_MOCKS=true
# Backend modes: mock = in-memory fixtures / authored tutor replies, real = Supabase / Gemini.
ATHENA_DATA_MODE=mock
ATHENA_AI_MODE=mock
# Content tutor (backend only). Models are used when ATHENA_AI_MODE=real; verify ids with
# `pnpm --filter @athena/api content:models`. Similarity is the evidence threshold for retrieval.
CONTENT_AI_PROVIDER=gemini
CONTENT_ANTHROPIC_CHAT_MODEL=claude-sonnet-5-5
CONTENT_ANTHROPIC_GUARD_MODEL=claude-haiku-5-5
CONTENT_CHAT_MODEL=gemini-3.8-flash
CONTENT_CHAT_FALLBACK_MODELS=gemini-3.5-flash,gemini-3-flash-preview
CONTENT_GUARD_MODEL=gemini-3.5-flash-lite
CONTENT_EMBED_MODEL=gemini-embedding-2
CONTENT_MIN_SIMILARITY=0.55
