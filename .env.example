# Copy to .env in the repo root and fill in. NEVER commit .env.
# frontend/web reads NEXT_PUBLIC_* from frontend/web/.env.local, so copy those lines there too.

# --- Supabase (Project Settings > API) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=          # server only, never expose to the browser
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Gemini (https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=

# --- Resend (https://resend.com/api-keys) ---
RESEND_API_KEY=

# --- Google Maps (Cloud Console > APIs & Services > Credentials) ---
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- App ---
PORT=4000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_USE_MOCKS=true
# Backend modes: mock = in-memory fixtures / authored tutor replies, real = Supabase / Gemini.
ATHENA_DATA_MODE=mock
ATHENA_AI_MODE=mock

# Global UI language (en by default; es remains supported). Restart/rebuild web after changing.
NEXT_PUBLIC_ATHENA_LOCALE=en
