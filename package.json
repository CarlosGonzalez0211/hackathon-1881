{
  "name": "athena",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm build:platform && pnpm -r --parallel --filter @athena/web --filter @athena/api dev",
    "dev:web": "pnpm build:platform && pnpm --filter @athena/web dev",
    "dev:api": "pnpm build:platform && pnpm --filter @athena/api dev",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "pnpm build:platform && pnpm -r typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "build:platform": "pnpm --filter @athena/shared build && pnpm --filter @athena/ai build && pnpm --filter @athena/world build",
    "test": "pnpm build:platform && pnpm --filter @athena/api exec tsx --test ../../shared/tests/*.test.ts tests/*.test.ts ../../frontend/engine3d/tests/*.test.ts ../../frontend/brand/tests/*.test.ts"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.3.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0"
  }
}
