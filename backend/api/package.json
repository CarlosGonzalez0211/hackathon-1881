{
  "name": "@athena/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "content:models": "tsx --env-file-if-exists=../../.env scripts/content-models.ts",
    "content:smoke": "tsx --env-file-if-exists=../../.env scripts/content-smoke.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@athena/shared": "workspace:*",
    "@supabase/supabase-js": "^2.47.10",
    "fastify": "^5.2.0",
    "resend": "^4.0.1",
    "zod": "^3.24.1",
    "@athena/ai": "workspace:*",
    "@athena/analytics": "workspace:*",
    "@athena/content": "workspace:*",
    "@athena/curriculum": "workspace:*",
    "@athena/learning": "workspace:*",
    "@athena/platform": "workspace:*",
    "@athena/world": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2"
  }
}
