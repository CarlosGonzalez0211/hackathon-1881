{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "api": {
      "root": "backend/api",
      "framework": "fastify",
      "entrypoint": "src/index.ts",
      "buildCommand": "pnpm --filter @athena/api... build"
    },
    "web": {
      "root": "frontend/web",
      "framework": "nextjs",
      "buildCommand": "pnpm --filter @athena/web... build"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": { "service": "api" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "web" }
    }
  ]
}
